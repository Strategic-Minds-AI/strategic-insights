{
  "name": "DomainMetricDaily",
  "type": "object",
  "properties": {
    "domain_id": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "source": {
      "type": "string",
      "enum": [
        "gsc",
        "ga4",
        "runtime",
        "competitor",
        "technical"
      ]
    },
    "clicks": {
      "type": "number",
      "default": 0
    },
    "impressions": {
      "type": "number",
      "default": 0
    },
    "ctr": {
      "type": "number",
      "default": 0
    },
    "average_position": {
      "type": "number",
      "default": 0
    },
    "users": {
      "type": "number",
      "default": 0
    },
    "sessions": {
      "type": "number",
      "default": 0
    },
    "conversions": {
      "type": "number",
      "default": 0
    },
    "revenue": {
      "type": "number",
      "default": 0
    },
    "metrics": {
      "type": "object"
    },
    "collected_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "domain_id",
    "date",
    "source"
  ],
  "rls": {
    "read": true,
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
