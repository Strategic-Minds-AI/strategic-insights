{
  "name": "DomainRegistry",
  "type": "object",
  "properties": {
    "domain": {"type": "string", "title": "Canonical Domain"},
    "canonical_url": {"type": "string", "title": "Canonical URL"},
    "business_id": {"type": "string"},
    "status": {"type": "string", "enum": ["onboarding","active","paused","blocked","archived"], "default": "onboarding"},
    "onboarding_phase": {"type": "string", "enum": ["registered","discovery","google_read","technical_baseline","competitor_baseline","monitoring","blocked"], "default": "registered"},
    "dns_provider": {"type": "string"},
    "repo_full_name": {"type": "string"},
    "repo_default_branch": {"type": "string"},
    "repo_sha": {"type": "string"},
    "vercel_project_id": {"type": "string"},
    "vercel_team_id": {"type": "string"},
    "production_url": {"type": "string"},
    "target_country": {"type": "string", "default": "US"},
    "target_state": {"type": "string"},
    "target_city": {"type": "string"},
    "target_keywords": {"type": "array", "items": {"type": "string"}, "default": []},
    "competitor_domains": {"type": "array", "items": {"type": "string"}, "default": []},
    "gsc_site_url": {"type": "string"},
    "gsc_permission_level": {"type": "string"},
    "gsc_verified": {"type": "boolean", "default": false},
    "ga_property_id": {"type": "string"},
    "ga_data_stream_id": {"type": "string"},
    "ga_measurement_id": {"type": "string"},
    "gtm_container_id": {"type": "string"},
    "sitemap_urls": {"type": "array", "items": {"type": "string"}, "default": []},
    "robots_url": {"type": "string"},
    "health_score": {"type": "number", "default": 0},
    "last_discovered_at": {"type": "string", "format": "date-time"},
    "last_reconciled_at": {"type": "string", "format": "date-time"},
    "next_action_at": {"type": "string", "format": "date-time"},
    "source_truth": {"type": "object"}
  },
  "required": ["domain","canonical_url"],
  "rls": {
    "read": true,
    "create": {"user_condition": {"role": "admin"}},
    "update": {"user_condition": {"role": "admin"}},
    "delete": {"user_condition": {"role": "admin"}}
  }
}
