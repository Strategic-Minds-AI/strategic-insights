{
  "name": "SyncState",
  "type": "object",
  "properties": {
    "page_token": {
      "type": "string",
      "title": "Drive Changes Page Token"
    },
    "last_sync_at": {
      "type": "string",
      "format": "date-time",
      "title": "Last Sync At"
    },
    "files_processed": {
      "type": "number",
      "title": "Files Processed"
    }
  },
  "required": [
    "page_token"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}