{
  "name": "VaultEntry",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Entry Name"
    },
    "service": {
      "type": "string",
      "title": "Service"
    },
    "key_name": {
      "type": "string",
      "title": "Key Name"
    },
    "key_value": {
      "type": "string",
      "title": "Key Value"
    },
    "description": {
      "type": "string",
      "title": "Description"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive"
      ],
      "default": "active",
      "title": "Status"
    }
  },
  "required": [
    "name",
    "service",
    "key_value"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}