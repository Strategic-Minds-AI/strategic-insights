{
  "name": "Domain Heartbeat",
  "description": "Single five-minute governed heartbeat that processes a bounded batch of due domains through domain_agent_reconcile, which routes every domain through execution ledger and postcondition validation.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "*/5 * * * *",
      "one_time_date": null,
      "timezone": "America/New_York",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "domain_heartbeat",
      "version": "2.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_reconciler": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "domain_agent_reconcile",
            "args": {
              "max_domains": 5
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Reconcile due domains",
            "description": "Process a bounded batch through the governed runner and durable validation receipts"
          }
        }
      }
    ]
  }
}
