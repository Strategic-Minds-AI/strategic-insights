{
  "name": "Domain Heartbeat",
  "description": "Daily autonomous pipeline that processes all due domains: crawls sitemaps, reads Search Console + GA4, scans competitors, and generates action items.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 6 * * *",
      "one_time_date": null,
      "timezone": "America/New_York",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "domain_heartbeat",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_pipeline": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "domain_run_pipeline",
            "args": {
              "action": "process_all"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Process all due domains",
            "description": "Crawl, read GSC + GA4, scan competitors, generate actions"
          }
        }
      }
    ]
  }
}