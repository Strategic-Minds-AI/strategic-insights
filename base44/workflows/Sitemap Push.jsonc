{
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "Domain"
    }
  },
  "description": "When a new domain is registered, queue sitemap submission for explicit operator approval. This workflow never writes to Google directly.",
  "name": "Sitemap Approval Queue",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "sitemap_approval_queue",
      "version": "2.0",
      "namespace": "base44"
    },
    "do": [
      {
        "wait_for_crawl": {
          "wait": "PT2M",
          "then": "request_approval",
          "x-base44": {
            "title": "Wait for initial crawl",
            "description": "Give the safe domain pipeline time to discover the sitemap"
          }
        }
      },
      {
        "request_approval": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "request_domain_approval",
            "args": {
              "domain_id": "${ .trigger.entity_id }",
              "action_type": "SUBMIT_SITEMAP"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Request sitemap approval",
            "description": "Queue protected Search Console sitemap submission; do not execute it automatically"
          }
        }
      }
    ]
  }
}
